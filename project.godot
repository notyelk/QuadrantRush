; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Quadrant Rush"
config/description="Serious game de priorização de tarefas com a Matriz de Eisenhower.
Trabalho de Conclusão de Curso em Engenharia de Software (UNINTER)."
run/main_scene="res://scenes/ui/tela_titulo.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[audio]

general/default_playback_type.web=0

[autoload]

GameManager="*res://autoload/game_manager.gd"
SupabaseClient="*res://autoload/supabase_client.gd"
Audio="*res://autoload/audio.gd"
Juice="*res://autoload/juice.gd"
Perfil="*res://autoload/perfil.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=208
window/size/mode=2
window/stretch/mode="canvas_items"

[global_group]

Player="Nó do personagem jogável, localizado por scripts (ex.: câmera) via get_nodes_in_group()."

